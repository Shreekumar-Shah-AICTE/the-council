# Copy this file to .env.local and fill in your actual keys.
# NEVER commit .env.local to git.

# ----- Band.ai Agent Credentials -----
# Register each agent at app.band.ai/agents → Connect Remote Agent
# Copy the Agent UUID and API Key (shown only once)

BAND_SKEPTIC_AGENT_ID=
BAND_SKEPTIC_API_KEY=
BAND_STRATEGIST_AGENT_ID=
BAND_STRATEGIST_API_KEY=
BAND_NUMBERS_AGENT_ID=
BAND_NUMBERS_API_KEY=
BAND_DEVILS_ADVOCATE_AGENT_ID=
BAND_DEVILS_ADVOCATE_API_KEY=
BAND_CHAIR_AGENT_ID=
BAND_CHAIR_API_KEY=

# ----- LLM Providers -----
# Featherless: https://featherless.ai → API Keys (Pro plan via BOA26 code)
FEATHERLESS_API_KEY=

# AI/ML API: https://api.aimlapi.com → Dashboard → API Key
AIMLAPI_KEY=

# ----- Brightdata (Optional) -----
# https://brightdata.com → Dashboard → API Key
BRIGHTDATA_API_KEY=

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
